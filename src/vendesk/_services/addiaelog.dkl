#include "dkli.dkh"
#!
module "listar-prospectos"
{
	#include "functions.dkh"
	#include "dbr.dkh"
	#include "serialize.dkh"
    #include "webcl.dkh"
    #include "website.dkl"
    #include "dbr.vars.dkl"
    #include "vendesk/_services/_assing_seller_lead.dkl"
    
    do cors_xhr()
    if @@(@http_context,"request/headers/REQUEST_METHOD")=="OPTIONS"{return}

    new response{@"success":@true}

    ref postData=@@(@http_context,"&request/post")
    if isnull(postData){ref postData=from.json(field.dstr(@http_context,"request/post_string","{}")) }
    
    ref db=get_db()
    ref user=@@(@http_context,"&session/user")

    ref notes=@@(postData,"&notes")

    token_cfg=trim(dbr.vars.get(db,"vendesk_notesToken"))
    token_iae=_auth.token()

    if token_iae == "" || token_cfg != token_iae{do rise_error(500,"No autorizado")}

    chat_id = @@(postData,"$chat_id")
    email = @@(postData,"$useremail")
    phone = @@(postData,"$userphone")

    email, phone, chat_id >> params

    chat_condition = ""
    has_chat_id = not(isnull(dbr.rec(db,"SHOW COLUMNS FROM ut_icontact LIKE 'chat_id_iae'",@null)))
    
    if has_chat_id { chat_condition = "(@chat_id <> '' AND ifnull(chat_id_iae,'') = @chat_id) OR" }

    sql = ftext("SELECT IFNULL((
    SELECT sys_pk
    FROM ut_icontact
    WHERE
        #<chat_condition>
        (@email <> '' AND trim(ifnull(uf_email,'')) = @email) OR
        (@phone <> '' AND REGEXP_REPLACE(trim(ifnull(uf_telefono,'')), '[^0-9]', '') = @phone)
    ORDER BY sys_pk DESC
    LIMIT 1),0)")
    lead_pk = dbr.num(db,sql,params)

    if lead_pk > 0 && has_chat_id {
        lead_pk >> params
        do dbr.execute(db,"UPDATE ut_icontact SET chat_id_iae = if(ifnull(chat_id_iae,'')='', @chat_id, chat_id_iae) WHERE sys_pk = @lead_pk",params)
    }
    m= _add_notes_iae(db,notes,lead_pk,chat_id)

    response<"data*">:@null
    response<"message">:m

    exception
    {
        using response
        {
            @"success":@false
            @"message":last_error()
            @"code":last_error_code()
        }
    }

    do SetHTTPResponse(response)
}